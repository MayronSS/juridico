# ============================================
# Site Jurídico — Variáveis de Ambiente
# ============================================
# Copie para .env.local e preencha os valores.
# NUNCA commite .env.local no git.

# --- Banco de Dados ---
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# --- Auth (NextAuth v5) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Clerk (quando migrar para Clerk) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
# CLERK_WEBHOOK_SECRET=""

# --- E-mail (Resend) ---
RESEND_API_KEY=""
CONTACT_EMAIL="contato@seudominio.com.br"

# --- Criptografia (AES-256) ---
# Gere com: openssl rand -base64 32
# ENCRYPTION_KEY=""

# --- Rate Limiting (Upstash Redis) ---
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Logging (Logtail / Better Stack) ---
# LOGTAIL_SOURCE_TOKEN=""

# --- Site (públicas — expostas ao browser) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Escritório Jurídico Modelo"
NEXT_PUBLIC_WHATSAPP_NUMBER="5500000000000"
